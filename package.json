{
  "name": "setup-ocaml",
  "version": "3.9.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run --recursive build",
    "fix": "vp check --fix",
    "knip": "knip && knip --strict",
    "lint": "vp check",
    "typecheck": "vp run --recursive typecheck"
  },
  "devDependencies": {
    "knip": "6.36.0",
    "vite-plus": "0.3.2"
  },
  "packageManager": "yarn@4.18.0"
}
