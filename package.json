{
  "name": "setup-ocaml",
  "version": "3.9.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run --recursive build",
    "fix": "vp check --fix",
    "knip": "knip && knip --strict",
    "lint": "vp check",
    "test": "vp run --recursive test",
    "test:update": "vp run --recursive test -- -u",
    "typecheck": "vp run --recursive typecheck"
  },
  "devDependencies": {
    "knip": "6.43.0",
    "ultracite": "8.1.0",
    "vite-plus": "1.4.0"
  },
  "packageManager": "yarn@4.18.1"
}
